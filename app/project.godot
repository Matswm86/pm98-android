; PM98 — native Android clone (Godot 4). Engine + 2D UI in one project.
; Match-highlights (Actua Soccer 2 3D + Barry Davies) are a later phase.

config_version=5

[application]

config/name="PM98"
config/description="Premier Manager 98 — native clone (personal project)"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameDB="*res://scripts/GameDB.gd"
TalentDB="*res://scripts/TalentDB.gd"
AudioManager="*res://scripts/AudioManager.gd"

[display]

; Native PM98 resolution (640x480, 4:3). stretch "keep" letterboxes the whole game
; uniformly to any device with dark margins -- the full screen is ALWAYS shown,
; nothing is ever cropped or distorted (faithful to the PC game in a window).
window/size/viewport_width=640
window/size/viewport_height=480
; resizable=false is what the Android exporter reads to stamp
; android:resizeableActivity="false" (export_plugin.cpp reads
; display/window/size/resizable). With targetSdk 35 + a landscape lock, leaving
; it resizable lets the OS apply size-compat scaling on tall phones -- the
; reported "half title screen, buttons off-picture" device bug.
window/size/resizable=false
; 4 = sensor_landscape: both landscape directions, never portrait (the PC game
; is landscape-only; 0 locked one single landscape direction).
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
; PM98 is pixel-exact 640x480 palette art -- NEAREST (0), never Godot's Linear
; default (1), or every scaled kit/crest/icon blurs. 51/52 scenes set NEAREST in
; _ready(); the hub (Main.gd) inherited the Linear default -> "home screen graphics
; fucked up / distorted jerseys" (owner #4, 2026-07-23). Set it project-wide so no
; CanvasItem can ever inherit Linear again.
textures/canvas_textures/default_texture_filter=0
; Dark letterbox margins around the 4:3 game area.
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.08, 1)
